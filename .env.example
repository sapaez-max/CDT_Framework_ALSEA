# Portal Alsea Delivery DEV
BASE_URL=https://dev.admin.delivery.alsea.net
APP_ENV=dev

# Correo que debe mostrarse despues del acceso manual
APP_ACCOUNT_DISPLAY_NAME=
AUTH_ENABLED=true
AUTH_ROLE=admin
AUTH_STATE_PATH=.auth/admin.json
AUTH_MINIMUM_VALIDITY_MS=60000
AUTH_CAPTURE_PROFILE_PATH=.auth/chrome-capture-profile
AUTH_CDP_PORT=9222
BROWSER_EXECUTABLE_PATH=

# Rutas observadas en el acceso validado manualmente
LOGIN_PATH=/login/
LANDING_PATH=/landing/

# Selectores configurables del formulario de Alsea
LOGIN_USERNAME_SELECTOR="#login"
LOGIN_PASSWORD_SELECTOR="#password"
LOGIN_SUBMIT_SELECTOR=button[type="submit"]
LOGIN_ACCOUNT_SELECTOR=
LOGIN_SUCCESS_SELECTOR=

E2E_AUTO_GOTO=false
# DEV no renderiza actualmente el formulario en Chromium headless.
HEADLESS=false
BROWSER_CHANNEL=chrome
VIDEO=on
WORKERS=1
RETRIES=0
TEST_TIMEOUT_MS=80000
ACTION_TIMEOUT_MS=30000
EXPECT_TIMEOUT_MS=35000
NAVIGATION_TIMEOUT_MS=50000
FILE_OPERATION_TIMEOUT_MS=50000
MANUAL_AUTH_TIMEOUT_MS=300000
VISOR_PROPAGATION_TIMEOUT_MS=300000

# Validacion de correo para descarga de plantillas
GMAIL_ENABLED=false
GMAIL_ACCOUNT=
GMAIL_USER_ID=me
GOOGLE_CREDENTIALS_PATH=.auth/google/credentials.json
GOOGLE_TOKEN_PATH=.auth/google/token.json
GMAIL_EXPECTED_FROM=no-reply@grupoalsea.com.mx
GMAIL_EXPECTED_SUBJECT=Descarga de la plantilla Desarrollo
GMAIL_POLL_TIMEOUT_MS=300000
GMAIL_POLL_INTERVAL_MS=5000
