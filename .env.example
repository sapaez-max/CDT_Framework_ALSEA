# Portal Alsea Delivery DEV
BASE_URL=https://dev.admin.delivery.alsea.net
APP_ENV=dev

# Correo que debe mostrarse despues del acceso manual
APP_ACCOUNT_DISPLAY_NAME=
AUTH_ENABLED=true
AUTH_ROLE=admin
AUTH_STATE_PATH=.auth/admin.json

# Rutas observadas en el acceso validado manualmente
LOGIN_PATH=/login/
LANDING_PATH=/landing/

# Selectores configurables del formulario de Alsea
LOGIN_USERNAME_SELECTOR="#login"
LOGIN_PASSWORD_SELECTOR="#password"
LOGIN_SUBMIT_SELECTOR=button[type="submit"]
LOGIN_ACCOUNT_SELECTOR=
LOGIN_SUCCESS_SELECTOR=

E2E_AUTO_GOTO=false
# DEV no renderiza actualmente el formulario en Chromium headless.
HEADLESS=false
BROWSER_CHANNEL=chrome
VIDEO=retain-on-failure
WORKERS=1
RETRIES=0
ACTION_TIMEOUT_MS=10000
EXPECT_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
MANUAL_AUTH_TIMEOUT_MS=300000
